# Current primary model configuration (updated after Revision 6).
# Direct OpenAI API is the default. Keep the key in .env only; never commit it.
LLM_API_KEY=
LLM_PROVIDER_NAME="OpenAI API"
LLM_API_MODE=responses
LLM_BASE_URL=
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=1200
LLM_API_TIMEOUT=90
LLM_MAX_RETRIES=0

# If using an OpenAI-compatible gateway that supports only Chat Completions,
# set LLM_API_MODE=chat_completions, LLM_BASE_URL to its /v1 base URL,
# LLM_PROVIDER_NAME to its actual provider name, and LLM_MODEL to the exact
# model identifier exposed by that provider. Confirm GPT-6 Luna is available
# through that provider before running any experiment.

TARGET_BASE_URL=http://127.0.0.1:8000
MAX_PAGES=5
REQUEST_TIMEOUT=10
MOCK_LLM=false
IPI_DEFENSE=false  # legacy compatibility only
DEFENSE_CONDITION=  # optional; NO_DEFENSE | INSTRUCTION_GUIDANCE | STRUCTURED_BOUNDARY; paired runner overrides per job
LAB_SYNTHETIC_SECRET=LAB_SECRET_2026_SYNTHETIC
LAB_SYNTHETIC_SESSION=LAB_SESSION_2026_SYNTHETIC
LAB_INTERNAL_CONTEXT=LAB_INTERNAL_CONTEXT_2026_SYNTHETIC
